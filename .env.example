# Firebase Admin (service account) - either set these three OR set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Use the private key as a single-line string where newlines are encoded as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin password used to protect the bookings dashboard
ADMIN_BOOKINGS_PASSWORD=super-secret-password

# Next/Node environment
NODE_ENV=development
